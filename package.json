{
  "name": "dsh-music-request",
  "version": "0.4.3",
  "private": true,
  "description": "点歌台：DSH Web 插件（Alt+T 面板，跨平台搜歌）+ IIROSE 用户脚本（一个 JS 链接即可在房间里点播）。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "iirose",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:iirose": "node scripts/build-iirose.mjs",
    "build:relay": "node scripts/build-relay.mjs",
    "build:relay:cjs": "node scripts/build-relay-cjs.mjs",
    "build:all": "node scripts/build.mjs && node scripts/build-iirose.mjs && node scripts/build-relay.mjs && node scripts/build-relay-cjs.mjs",
    "test": "node dev/smoke-client.mjs && node dev/panel-jsdom.mjs && node dev/scopes-jsdom.mjs && node dev/iirose-smoke.mjs && node dev/mobile-iirose.mjs && node dev/serverless-smoke.mjs",
    "test:relay": "node dev/relay-smoke.mjs",
    "test:serverless": "node dev/serverless-smoke.mjs",
    "dev:server": "node dev/server.mjs",
    "relay": "node relay/dev-server.mjs",
    "test:adapters": "node dev/try-adapters.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "music",
    "music-request",
    "netease",
    "kugou",
    "qqmusic",
    "bilibili"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeqiqiye/music-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/yeqiqiye/music-plugin/issues"
  },
  "homepage": "https://github.com/yeqiqiye/music-plugin#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
